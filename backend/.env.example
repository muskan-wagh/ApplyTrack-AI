# Copy to .env (never commit .env)
NODE_ENV=development
PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/applytrack-ai
CORS_ORIGIN=http://localhost:5173

# Resume RAG (OpenRouter unified: embeddings + chat generation).
# Leave OPENROUTER_API_KEY empty to run the tracker without AI features;
# RAG endpoints return 503 until it is set. Never commit real keys.
OPENROUTER_API_KEY=
EMBEDDING_MODEL=openai/text-embedding-3-small
EMBEDDING_DIMS=1536
RAG_CHAT_MODEL=openai/gpt-4o-mini
RAG_TOP_K=5
RAG_MIN_SCORE=0.1
MAX_RESUME_MB=5
MAX_RESUME_CHARS=200000
